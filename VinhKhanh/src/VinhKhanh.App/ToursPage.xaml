<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VinhKhanh.App.ViewModels"
             xmlns:data="clr-namespace:VinhKhanh.Infrastructure.Data;assembly=VinhKhanh.Infrastructure"
             x:Class="VinhKhanh.App.ToursPage"
             x:DataType="vm:ToursViewModel"
             Title="Lộ Trình Khám Phá"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Premium Header -->
        <Frame Grid.Row="0" 
               Padding="25, 50, 25, 25" 
               CornerRadius="0" 
               HasShadow="True" 
               BorderColor="Transparent">
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#1E293B" Offset="1" />
                </LinearGradientBrush>
            </Frame.Background>
            <VerticalStackLayout Spacing="8">
                <Label Text="TRẢI NGHIỆM ĐẶC SẮC" 
                       TextColor="#EA580C" 
                       FontSize="11" 
                       FontAttributes="Bold" 
                       CharacterSpacing="2"/>
                <Label Text="Lộ Trình Ẩm Thực" 
                       TextColor="White" 
                       FontSize="30" 
                       FontAttributes="Bold"/>
                <Label Text="Gợi ý các cung đường ngon nhất dành cho bạn" 
                       TextColor="#94A3B8" 
                       FontSize="14"/>
            </VerticalStackLayout>
        </Frame>

        <!-- Tours Collection -->
        <RefreshView Grid.Row="1" 
                     Command="{Binding LoadCommand}" 
                     IsRefreshing="{Binding IsBusy}" 
                     RefreshColor="#EA580C">
            
            <CollectionView ItemsSource="{Binding Tours}"
                            Margin="20"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="20"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:Tour">
                        <Border StrokeThickness="0" 
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="White">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ToursViewModel}}, Path=SelectTourCommand}" 
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,6" Opacity="0.08" Radius="12"/>
                            </Border.Shadow>

                            <Grid RowDefinitions="Auto, Auto" Padding="0">
                                <!-- Top Accent Color -->
                                <BoxView Grid.Row="0" HeightRequest="8" Color="#EA580C" VerticalOptions="Start"/>

                                <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="10">
                                    <Label Text="{Binding Name}" 
                                           FontSize="20" 
                                           FontAttributes="Bold" 
                                           TextColor="#0F172A"/>
                                    
                                    <Label Text="{Binding Description}" 
                                           FontSize="14" 
                                           TextColor="#475569" 
                                           MaxLines="2" 
                                           LineBreakMode="TailTruncation"
                                           LineHeight="1.2"/>

                                    <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,5"/>

                                    <Grid ColumnDefinitions="*, *, Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="📍" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="5 điểm dừng" 
                                                   FontSize="13" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#EA580C"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="⏱" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="{Binding EstimatedMinutes, StringFormat='{0} phút'}" 
                                                   FontSize="13" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#64748B"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <Label Grid.Column="2" 
                                               Text="Bắt đầu →" 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="#EA580C"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="15" Padding="40" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🗺" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="Không tìm thấy lộ trình" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#64748B" 
                               HorizontalOptions="Center"/>
                        <Label Text="Hãy thử kéo xuống để cập nhật lại danh sách lộ trình từ máy chủ." 
                               FontSize="14" 
                               TextColor="#94A3B8" 
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
