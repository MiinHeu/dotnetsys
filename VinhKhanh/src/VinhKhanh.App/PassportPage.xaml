<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VinhKhanh.App.ViewModels"
             x:Class="VinhKhanh.App.PassportPage"
             x:DataType="vm:PassportViewModel"
             Title="Hộ Chiếu Du Lịch"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <Frame Grid.Row="0" Padding="25, 50, 25, 25" CornerRadius="0" HasShadow="True" BorderColor="Transparent" BackgroundColor="#EA580C">
            <VerticalStackLayout Spacing="8">
                <Label Text="BỘ SƯU TẬP TEM" TextColor="#FFDAB9" FontSize="11" FontAttributes="Bold" CharacterSpacing="2"/>
                <Label Text="Hộ Chiếu Vĩnh Khánh" TextColor="White" FontSize="28" FontAttributes="Bold"/>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{Binding ProgressText}" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="• Quét QR để nhận thêm tem!" TextColor="#FFF5EE" FontSize="14"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Stamps Grid -->
        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="False" RefreshColor="#EA580C">
            <CollectionView ItemsSource="{Binding Stamps}" Margin="15">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="15" HorizontalItemSpacing="15"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StampItem">
                        <Border StrokeThickness="0" 
                                StrokeShape="RoundRectangle 20" 
                                BackgroundColor="White"
                                HeightRequest="180">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="8"/>
                            </Border.Shadow>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="10">
                                <!-- Stamp Icon Container -->
                                <Frame WidthRequest="80" 
                                       HeightRequest="80" 
                                       CornerRadius="40" 
                                       Padding="0" 
                                       HorizontalOptions="Center"
                                       BackgroundColor="{Binding StampBg}"
                                       BorderColor="Transparent">
                                    <Label Text="🍜" 
                                           FontSize="40" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"
                                           Opacity="{Binding StampOpacity}"/>
                                </Frame>

                                <Label Text="{Binding Name}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#0F172A" 
                                       HorizontalOptions="Center" 
                                       HorizontalTextAlignment="Center"
                                       MaxLines="2"/>
                                
                                <Border BackgroundColor="{Binding StatusColor}" 
                                        StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 10" 
                                        Padding="8,2" 
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding StatusText}" 
                                           FontSize="10" 
                                           TextColor="White" 
                                           FontAttributes="Bold"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="15" Padding="40" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📔" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="Hộ chiếu chưa có tem nào" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#64748B" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
