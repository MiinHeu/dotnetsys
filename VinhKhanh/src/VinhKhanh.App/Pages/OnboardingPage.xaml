<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanh.App.Pages.OnboardingPage"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="*, Auto">
        
        <!-- Carousel for Steps -->
        <CarouselView x:Name="OnboardingCarousel" 
                      ItemsSource="{Binding Steps}"
                      IndicatorView="Indicator"
                      Loop="False">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="*, Auto, Auto" Padding="40">
                        <!-- Image/Icon Placeholder -->
                        <Frame Grid.Row="0" 
                               HeightRequest="250" 
                               WidthRequest="250" 
                               CornerRadius="125" 
                               BackgroundColor="#1E293B" 
                               BorderColor="Transparent"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center">
                            <Label Text="{Binding Icon}" 
                                   FontSize="100" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
                        </Frame>

                        <Label Grid.Row="1" 
                               Text="{Binding Title}" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center"
                               Margin="0,40,0,10"/>

                        <Label Grid.Row="2" 
                               Text="{Binding Description}" 
                               FontSize="16" 
                               TextColor="#94A3B8" 
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center" 
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Bottom Controls -->
        <VerticalStackLayout Grid.Row="1" Padding="30, 0, 30, 50" Spacing="20">
            <IndicatorView x:Name="Indicator"
                           IndicatorColor="#1E293B"
                           SelectedIndicatorColor="#EA580C"
                           HorizontalOptions="Center" />

            <Button x:Name="NextBtn"
                    Text="Tiếp theo"
                    Clicked="OnNextClicked"
                    BackgroundColor="#EA580C"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

            <Button x:Name="SkipBtn"
                    Text="Bỏ qua"
                    Clicked="OnStartClicked"
                    BackgroundColor="Transparent"
                    TextColor="#94A3B8"
                    FontAttributes="Bold"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
