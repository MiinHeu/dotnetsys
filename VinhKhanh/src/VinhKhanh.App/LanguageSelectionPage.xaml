<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:VinhKhanh.App.Resources.Strings"
             x:Class="VinhKhanh.App.LanguageSelectionPage"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#1A1A1A}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" Padding="24, 60, 24, 24">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,40">
            <Label Text="🌍" FontSize="60" HorizontalOptions="Center" Margin="0,0,0,10"/>
            <Label Text="{x:Static res:AppResources.LanguageSelectionTitle}" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#111827, Dark=#FFFFFF}" 
                   HorizontalOptions="Center"/>
            <Label Text="{x:Static res:AppResources.LanguageSelectionDesc}" 
                   FontSize="16" 
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}" 
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        
        <!-- Language Cards -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16">
                
                <!-- English -->
                <Frame Style="{StaticResource LangCardStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLangSelected" CommandParameter="en" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🇬🇧" FontSize="30" VerticalOptions="Center" Margin="0,0,20,0"/>
                        <Label Grid.Column="1" Text="English" Style="{StaticResource LangTextStyle}"/>
                    </Grid>
                </Frame>

                <!-- Tiếng Việt -->
                <Frame Style="{StaticResource LangCardStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLangSelected" CommandParameter="vi" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🇻🇳" FontSize="30" VerticalOptions="Center" Margin="0,0,20,0"/>
                        <Label Grid.Column="1" Text="Tiếng Việt" Style="{StaticResource LangTextStyle}"/>
                    </Grid>
                </Frame>

                <!-- 中文 -->
                <Frame Style="{StaticResource LangCardStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLangSelected" CommandParameter="zh" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🇨🇳" FontSize="30" VerticalOptions="Center" Margin="0,0,20,0"/>
                        <Label Grid.Column="1" Text="中文" Style="{StaticResource LangTextStyle}"/>
                    </Grid>
                </Frame>

                <!-- 한국어 -->
                <Frame Style="{StaticResource LangCardStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLangSelected" CommandParameter="ko" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🇰🇷" FontSize="30" VerticalOptions="Center" Margin="0,0,20,0"/>
                        <Label Grid.Column="1" Text="한국어" Style="{StaticResource LangTextStyle}"/>
                    </Grid>
                </Frame>

                <!-- 日本語 -->
                <Frame Style="{StaticResource LangCardStyle}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLangSelected" CommandParameter="ja" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🇯🇵" FontSize="30" VerticalOptions="Center" Margin="0,0,20,0"/>
                        <Label Grid.Column="1" Text="日本語" Style="{StaticResource LangTextStyle}"/>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="LangCardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="24, 20" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="Margin" Value="4, 0" />
            </Style>
            
            <Style x:Key="LangTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
</ContentPage>
