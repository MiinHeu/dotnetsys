<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:VinhKhanh.App.Resources.Strings"
             x:Class="VinhKhanh.App.ChatPage"
             Title="{x:Static res:AppResources.TabChat}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <Picker x:Name="LangPicker" Title="{x:Static res:AppResources.LanguagePickerTitle}" />
        <CollectionView x:Name="ChatList" Grid.Row="1" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="MsgEntry" />
            <Button Grid.Column="1" Text="{x:Static res:AppResources.ChatSendButton}" Clicked="OnSend" />
        </Grid>
    </Grid>
</ContentPage>
