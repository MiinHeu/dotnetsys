<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VinhKhanh.App.ViewModels"
             xmlns:models="clr-namespace:VinhKhanh.App.Models"
             x:Class="VinhKhanh.App.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="Trợ Lý Bé Vinh"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Header with Mascot Info -->
        <Frame Grid.Row="0" Padding="15" CornerRadius="0" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <Frame WidthRequest="50" HeightRequest="50" CornerRadius="25" Padding="0" IsClippedToBounds="True" BorderColor="#EA580C">
                    <Image Source="dotnet_bot.png" Aspect="AspectFit" Margin="5"/>
                </Frame>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Bé Vinh AI" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                    <HorizontalStackLayout Spacing="5">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#10B981" VerticalOptions="Center"/>
                        <Label Text="Đang trực tuyến" FontSize="12" TextColor="#64748B"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <!-- Messages List -->
        <CollectionView x:Name="ChatList"
                        Grid.Row="1" 
                        ItemsSource="{Binding Messages}" 
                        Margin="15"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,5">
                        <!-- Bot Message Container -->
                        <VerticalStackLayout HorizontalOptions="Start" 
                                             IsVisible="{Binding IsBot}" 
                                             Spacing="2" 
                                             MaximumWidthRequest="300">
                            <Label Text="Bé Vinh" FontSize="10" TextColor="#64748B" Margin="10,0"/>
                            <Border BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 16,16,16,2" Padding="12,8">
                                <Label Text="{Binding Content}" TextColor="#1E293B" FontSize="15" LineBreakMode="WordWrap"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- User Message Container -->
                        <VerticalStackLayout HorizontalOptions="End" 
                                             IsVisible="{Binding IsUser}" 
                                             Spacing="2" 
                                             MaximumWidthRequest="300">
                            <Border BackgroundColor="#EA580C" StrokeThickness="0" StrokeShape="RoundRectangle 16,16,2,16" Padding="12,8">
                                <Label Text="{Binding Content}" TextColor="White" FontSize="15" LineBreakMode="WordWrap"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Input Area -->
        <Frame Grid.Row="2" Padding="15" CornerRadius="0" HasShadow="False" BorderColor="#F1F5F9" BackgroundColor="White">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 25" Padding="15, 0">
                    <Entry x:Name="ChatEntry"
                           Text="{Binding CurrentMessage}"
                           Placeholder="Hỏi Bé Vinh về món ngon..."
                           PlaceholderColor="#94A3B8"
                           TextColor="#1E293B"
                           FontSize="15"
                           HeightRequest="45"
                           ReturnCommand="{Binding SendCommand}"/>
                </Border>
                
                <Button Grid.Column="1"
                        Text="Gửi"
                        Command="{Binding SendCommand}"
                        BackgroundColor="#EA580C"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="45"
                        WidthRequest="70"/>
            </Grid>
        </Frame>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1" IsVisible="{Binding IsBusy}" BackgroundColor="#40FFFFFF">
            <ActivityIndicator IsRunning="True" Color="#EA580C" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="40"/>
        </Grid>

    </Grid>
</ContentPage>
