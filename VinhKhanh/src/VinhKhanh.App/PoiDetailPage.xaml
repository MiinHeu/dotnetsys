<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VinhKhanh.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:res="clr-namespace:VinhKhanh.App.Resources.Strings"
             x:Class="VinhKhanh.App.PoiDetailPage"
             x:DataType="vm:PoiDetailViewModel"
             Title="{Binding PageTitle}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="300, *">
        <!-- Banner Image -->
        <Grid Grid.Row="0">
            <Image Source="{Binding Poi.ImageUrl, TargetNullValue='icon_restaurant_placeholder.png'}" 
                   Aspect="AspectFill" />
            
            <!-- Gradient Overlay for better contrast -->
            <BoxView Opacity="0.4">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="Black" Offset="1" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Back Button -->
            <ImageButton Source="icon_back_white.png" 
                         Command="{Binding GoBackCommand}"
                         HorizontalOptions="Start" 
                         VerticalOptions="Start" 
                         Margin="20,40"
                         BackgroundColor="#40000000"
                         Padding="10"
                         CornerRadius="22" 
                         HeightRequest="44" WidthRequest="44"/>
        </Grid>

        <!-- Content Area -->
        <ScrollView Grid.Row="1" Margin="0,-20,0,0">
            <Frame HasShadow="False" CornerRadius="20" Padding="20" BackgroundColor="White" BorderColor="Transparent">
                <StackLayout Spacing="15">
                    <!-- Title & Category -->
                    <StackLayout Spacing="5">
                        <Label Text="{Binding DisplayName}" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="#111827" />
                        
                        <Label Text="{Binding Poi.Category}" 
                               TextColor="#FF5A1F" 
                               FontSize="16" 
                               FontAttributes="Italic" />
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6" />

                    <!-- Description -->
                    <Label Text="{Binding DisplayDescription}" 
                           FontSize="16" 
                           TextColor="#4B5563" 
                           LineHeight="1.5" />

                    <Label Text="{x:Static res:AppResources.PlaybackPoiLabel}" 
                           FontSize="12" 
                           TextColor="#9CA3AF" 
                           Margin="0,20,0,0" />
                </StackLayout>
            </Frame>
        </ScrollView>

        <!-- Floating Action Button: Play Narration -->
        <Button Grid.Row="1"
                Text="{Binding PlayNarrationText}"
                Command="{Binding PlayNarrationCommand}"
                BackgroundColor="#FF5A1F"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="50"
                Margin="40,0,40,20"
                VerticalOptions="End"
                IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,10" Opacity="0.3" Radius="10" />
            </Button.Shadow>
        </Button>

        <Button Grid.Row="1"
                Text="{Binding StopNarrationText}"
                Command="{Binding StopNarrationCommand}"
                BackgroundColor="#E5E7EB"
                TextColor="#374151"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="50"
                Margin="40,0,40,20"
                VerticalOptions="End"
                IsVisible="{Binding IsPlaying}" />
    </Grid>
</ContentPage>
