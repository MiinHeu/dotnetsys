<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VinhKhanh.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:res="clr-namespace:VinhKhanh.App.Resources.Strings"
             x:Class="VinhKhanh.App.PoiDetailPage"
             x:DataType="vm:PoiDetailViewModel"
             Title="{Binding PageTitle}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#121212}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="300, *">
        <!-- Banner Image Carousel (Mock with Main Image for now) -->
        <Grid Grid.Row="0">
            <Image Source="{Binding PoiDetail.ImageUrl, TargetNullValue='icon_restaurant_placeholder.png'}" 
                   Aspect="AspectFill" />
            
            <BoxView Opacity="0.5">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#50000000" Offset="0" />
                        <GradientStop Color="Transparent" Offset="0.5" />
                        <GradientStop Color="#A0000000" Offset="1" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
        </Grid>

        <!-- Content Area -->
        <ScrollView Grid.Row="1" Margin="0,-30,0,0">
            <Frame HasShadow="False" 
                   CornerRadius="30" 
                   Padding="20, 30" 
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="20">
                    
                    <!-- Header: Name & Rating -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding DisplayName}" 
                                   FontSize="26" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#111827, Dark=#FFFFFF}" />
                            <Label Text="{Binding PoiDetail.Category}" 
                                   TextColor="#FF5A1F" 
                                   FontSize="16" />
                        </VerticalStackLayout>
                        <Frame Grid.Column="1" 
                               BackgroundColor="#FFFAF0" 
                               CornerRadius="12" 
                               Padding="10,5" 
                               HasShadow="False"
                               VerticalOptions="Start">
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="⭐" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="{Binding PoiDetail.Rating, StringFormat='{0:F1}'}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="#F59E0B"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F3F4F6, Dark=#333333}" />

                    <!-- Quick Info -->
                    <VerticalStackLayout Spacing="12">
                        <!-- Address -->
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="📍" FontSize="18" Margin="0,0,10,0"/>
                            <Label Grid.Column="1" Text="{Binding PoiDetail.Address, TargetNullValue='Đường Vĩnh Khánh, Quận 4, TP.HCM'}" 
                                   FontSize="15" TextColor="{AppThemeBinding Light=#4B5563, Dark=#A1A1AA}"/>
                        </Grid>
                        <!-- Operating Hours -->
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="⏰" FontSize="18" Margin="0,0,10,0"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Đang mở cửa" TextColor="#10B981" FontAttributes="Bold" FontSize="15"/>
                                <Label Text="•" TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#666666}" FontSize="15"/>
                                <Label Text="{Binding PoiDetail.OperatingHours, TargetNullValue='16:00 - 23:00'}" 
                                       FontSize="15" TextColor="{AppThemeBinding Light=#4B5563, Dark=#A1A1AA}"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Buttons Row -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10">
                        <Button Grid.Column="0" 
                                Text="🗺️ Dẫn đường"
                                BackgroundColor="#F3F4F6"
                                TextColor="#111827"
                                CornerRadius="12"
                                FontAttributes="Bold"
                                HeightRequest="50" />
                        <Button Grid.Column="1" 
                                Text="🍽️ Xem Menu"
                                BackgroundColor="#FFF1F2"
                                TextColor="#E11D48"
                                CornerRadius="12"
                                FontAttributes="Bold"
                                HeightRequest="50" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F3F4F6, Dark=#333333}" />

                    <!-- Menu Section -->
                    <Label Text="Thực đơn nổi bật" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=#FFFFFF}" />
                    <CollectionView ItemsSource="{Binding MenuItems}" HeightRequest="150">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="12" Padding="15" HasShadow="False" BackgroundColor="#FFF5EE" BorderColor="#FFE4D1">
                                    <Label Text="{Binding .}" TextColor="#D35400" FontAttributes="Bold" VerticalOptions="Center"/>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F3F4F6, Dark=#333333}" />

                    <!-- Description -->
                    <Label Text="Giới thiệu" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=#FFFFFF}" />
                    <Label Text="{Binding DisplayDescription}" 
                           FontSize="16" 
                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#A1A1AA}" 
                           LineHeight="1.5" />

                    <!-- Spacer for Floating Button -->
                    <BoxView HeightRequest="80" Color="Transparent" />
                </VerticalStackLayout>
            </Frame>
        </ScrollView>

        <!-- Floating Action Button: Play Narration -->
        <Button Grid.Row="1"
                Text="🎧 Nghe Thuyết Minh (AI)"
                Command="{Binding PlayNarrationCommand}"
                BackgroundColor="#FF4500"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="25"
                HeightRequest="55"
                Margin="30,0,30,25"
                VerticalOptions="End"
                IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}">
            <Button.Shadow>
                <Shadow Brush="#FF4500" Offset="0,5" Opacity="0.4" Radius="10" />
            </Button.Shadow>
        </Button>

        <Button Grid.Row="1"
                Text="⏹ Dừng Thuyết Minh"
                Command="{Binding StopNarrationCommand}"
                BackgroundColor="#374151"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="25"
                HeightRequest="55"
                Margin="30,0,30,25"
                VerticalOptions="End"
                IsVisible="{Binding IsPlaying}">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,5" Opacity="0.2" Radius="10" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
