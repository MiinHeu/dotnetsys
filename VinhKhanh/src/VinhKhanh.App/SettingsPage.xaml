<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:VinhKhanh.App.Resources.Strings"
             x:Class="VinhKhanh.App.SettingsPage"
             Title="{x:Static res:AppResources.TabSettings}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="{x:Static res:AppResources.SettingsApiUrlLabel}" FontAttributes="Bold" />
            <Entry x:Name="ApiUrlEntry" Placeholder="http://10.0.2.2:5283/" />
            
            <Label Text="{x:Static res:AppResources.SettingsGeofenceRadiusLabel}" />
            <Entry x:Name="RadiusMultEntry" Keyboard="Numeric" Placeholder="1" />
            
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="{x:Static res:AppResources.SettingsMockGpsLabel}" VerticalOptions="Center" />
                <Switch x:Name="MockGpsSwitch" />
            </HorizontalStackLayout>
            <Label FontSize="11" TextColor="#999"
                   Text="{x:Static res:AppResources.SettingsMockGpsDesc}"
                   IsVisible="{Binding IsToggled, Source={x:Reference MockGpsSwitch}}" />

            <BoxView HeightRequest="1" Color="#DDD" Margin="0,4" />
            
            <Button Text="{x:Static res:AppResources.SettingsSaveButton}" Clicked="OnSave" />
            <Label x:Name="HintLabel" FontSize="12" TextColor="#666"
                   Text="{x:Static res:AppResources.SettingsApiHint}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
