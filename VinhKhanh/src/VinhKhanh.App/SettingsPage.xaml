<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanh.App.SettingsPage"
             Title="Cài đặt"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- System Connection Section -->
            <Label Text="Hệ Thống" FontAttributes="Bold" TextColor="#FF5A1F" Margin="5,0,0,0"/>
            <Frame CornerRadius="15" Padding="20" HasShadow="True" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🌐" FontSize="18" Margin="0,0,10,0"/>
                        <Label Grid.Column="1" Text="Địa chỉ API" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                    </Grid>
                    <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#2D2D2D}" Padding="10,0" StrokeShape="RoundRectangle 8">
                        <Entry x:Name="ApiUrlEntry" 
                               Placeholder="http://10.0.2.2:5283/" 
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                               FontSize="14"/>
                    </Border>
                    <Label Text="Dùng 10.0.2.2 cho Emulator hoặc IP máy tính cho thiết bị thật." FontSize="12" TextColor="#9CA3AF"/>
                </VerticalStackLayout>
            </Frame>

            <!-- GPS & Tracking Section -->
            <Label Text="GPS &amp; Trải Nghiệm" FontAttributes="Bold" TextColor="#FF5A1F" Margin="5,10,0,0"/>
            <Frame CornerRadius="15" Padding="20" HasShadow="True" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Bán kính Geofence" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                            <Label Text="Hệ số nhân bán kính (mặc định: 1)" FontSize="12" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="60" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#2D2D2D}" Padding="5,0" StrokeShape="RoundRectangle 8">
                            <Entry x:Name="RadiusMultEntry" Keyboard="Numeric" HorizontalTextAlignment="Center" Placeholder="1" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F3F4F6, Dark=#333333}"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Chế độ mô phỏng" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                            <Label Text="Tự động di chuyển qua các điểm" FontSize="12" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="MockGpsSwitch" OnColor="#FF5A1F" ThumbColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Lưu Cấu Hình" 
                    Clicked="OnSave" 
                    BackgroundColor="#FF5A1F" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    HeightRequest="55" 
                    CornerRadius="15" 
                    Margin="0,20,0,0">
                <Button.Shadow>
                    <Shadow Brush="#FF5A1F" Offset="0,5" Opacity="0.3" Radius="10"/>
                </Button.Shadow>
            </Button>

            <Label Text="Phiên bản 2.0.0 (Premium Build)" HorizontalTextAlignment="Center" FontSize="12" TextColor="#9CA3AF" Margin="0,10"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
