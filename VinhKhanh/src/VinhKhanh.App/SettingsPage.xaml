<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanh.App.SettingsPage"
             Title="Cai dat">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" BackgroundColor="#F8FAFC">
            <Border Stroke="#E2E8F0" Background="#FFFFFF" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Ket noi he thong" FontAttributes="Bold" FontSize="16" />
                    <Label Text="URL API (co / cuoi hoac khong deu duoc)" FontAttributes="Bold" />
                    <Entry x:Name="ApiUrlEntry" Placeholder="http://10.0.2.2:5283/" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#E2E8F0" Background="#FFFFFF" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Theo doi vi tri" FontAttributes="Bold" FontSize="16" />
                    <Label Text="He so ban kinh geofence (1 = mac dinh)" />
                    <Entry x:Name="RadiusMultEntry" Keyboard="Numeric" Placeholder="1" />

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Bat mo phong lo trinh GPS (.NET Mock)" VerticalOptions="Center" />
                        <Switch x:Name="MockGpsSwitch" />
                    </HorizontalStackLayout>
                    <Label FontSize="11" TextColor="#64748B"
                           Text="Bat: blue-dot tu di qua cac POI roi quay lai, loop lien tuc."
                           IsVisible="{Binding IsToggled, Source={x:Reference MockGpsSwitch}}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Luu" Clicked="OnSave" />
            <Label x:Name="HintLabel" FontSize="12" TextColor="#64748B"
                   Text="Android emulator: 10.0.2.2 thay localhost. May that: IP LAN cua PC." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
